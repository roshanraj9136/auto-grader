# Copy to .env and fill in. Without a key AutoGrader runs in deterministic "heuristic" mode.
# Free AI reviewers: a Groq key (https://console.groq.com/keys, starts with gsk_) or a Gemini key
# (https://aistudio.google.com/apikey). The right endpoint and models are picked from the key.
AUTOGRADER_LLM_API_KEY=
# Or Claude (paid): set this instead
ANTHROPIC_API_KEY=

# Model tiering (specialists vs judge). Leave empty for the provider's defaults; the specialist setting can list
# several models separated by commas (Groq default: openai/gpt-oss-20b,openai/gpt-oss-120b).
AUTOGRADER_AGENT_MODEL=
AUTOGRADER_JUDGE_MODEL=
AUTOGRADER_AGENT_MAX_TOKENS=1500
AUTOGRADER_JUDGE_MAX_TOKENS=1600
# Optional reasoning effort hint (low|medium|high); leave empty to not send it
AUTOGRADER_EFFORT=

# Latency / resilience
# AUTOGRADER_LLM_CONCURRENCY=8   (default: 8 for Claude, 3 for free tiers)
AUTOGRADER_LLM_MAX_RETRIES=2
AUTOGRADER_AGENT_TIMEOUT=120
AUTOGRADER_JUDGE_TIMEOUT=150

# Docker sandbox. Set to 0 to never build/run untrusted Dockerfiles (static lint only)
AUTOGRADER_ENABLE_DOCKER=1
AUTOGRADER_DOCKER_BUILD_TIMEOUT=600
AUTOGRADER_DOCKER_RUN_WAIT=8

# Jobs
AUTOGRADER_MAX_CONCURRENT_JOBS=2
AUTOGRADER_MAX_STORED_JOBS=200

# ---- Learning platform -------------------------------------------------------
# Database: empty = SQLite file in the work dir. docker compose sets PostgreSQL automatically.
AUTOGRADER_DATABASE_URL=
# 1 = grading requires a logged-in user (or AUTOGRADER_API_TOKEN as a Bearer token for scripts)
AUTOGRADER_REQUIRE_LOGIN=1
# 1 = create demo accounts (student@/instructor@autograder.local) + sample assignments on first run.
# Set to 0 before exposing the server to untrusted users.
AUTOGRADER_DEMO_SEED=1
# Real instructor account created on first run (recommended when AUTOGRADER_DEMO_SEED=0)
AUTOGRADER_INSTRUCTOR_EMAIL=
AUTOGRADER_INSTRUCTOR_PASSWORD=
# Optional class join code required for student self sign-up
AUTOGRADER_SIGNUP_CODE=
AUTOGRADER_SESSION_TTL_HOURS=72
# 1 when served over HTTPS (marks the session cookie Secure)
AUTOGRADER_COOKIE_SECURE=0
# Optional bearer token for API/CI submissions
AUTOGRADER_API_TOKEN=

# docker compose only
POSTGRES_PASSWORD=autograder-local-only
API_REPLICAS=3
AUTOGRADER_PORT=8080
# 127.0.0.1 = this machine only. 0.0.0.0 = whole LAN (then set AUTOGRADER_DEMO_SEED=0 + an instructor account)
AUTOGRADER_BIND=127.0.0.1
